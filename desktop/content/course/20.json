    {
      "h": "Trucos para memorizarlos por grupos",
      "body": "No memorices 60 verbos sueltos. Agrúpalos por patrón:",
      "table": {
        "head": [
          "Patrón",
          "Verbos",
          "Idea"
        ],
        "rows": [
          [
            "Los tres iguales",
            "put - put - put, cut - cut - cut, let - let - let, cost - cost - cost, hurt - hurt - hurt, read - read - read",
            "No cambian nada"
          ],
          [
            "Pasado = participio (-ought / -aught)",
            "buy - bought - bought, bring - brought - brought, think - thought - thought, catch - caught - caught, teach - taught - taught",
            "Todos suenan parecido"
          ],
          [
            "Pasado = participio con -t",
            "sleep - slept, keep - kept, feel - felt, leave - left, send - sent, lend - lent, build - built, spend - spent",
            "Cambian a una -t final"
          ],
          [
            "i - a - u",
            "sing - sang - sung, swim - swam - swum, drink - drank - drunk, begin - began - begun",
            "Cambian las vocales: i, a, u"
          ],
          [
            "-ow / -ew / -own",
            "know - knew - known, fly - flew - flown, draw - drew - drawn",
            "El participio termina en -n"
          ],
          [
            "Participio con -en",
            "take - took - taken, break - broke - broken, speak - spoke - spoken, choose - chose - chosen, wake - woke - woken, eat - ate - eaten, give - gave - given",
            "El participio termina en -en"
          ]
        ]
      },
      "note": "Practica diciendo cada grupo en voz alta, como una canción: *buy, bought, bought; bring, brought, brought*."
