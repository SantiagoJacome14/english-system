{
  "name": "english-boarding-pass",
  "productName": "English Boarding Pass",
  "version": "1.0.0",
  "description": "Tu app diaria de inglés: rutina, conversación por voz con Claude, plan y progreso",
  "main": "main.js",
  "author": "SantiagoJacome14",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0"
  },
  "devDependencies": {
    "electron": "43.7.7",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.santiagojacome.englishboardingpass",
    "productName": "English Boarding Pass",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "index.html", "package.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "English Boarding Pass" }
  }
}
